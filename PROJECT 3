from flask import Flask, request, jsonify
import joblib
import numpy as np

# Initialize the Flask application
app = Flask(__name__)
# Load the trained model
# This is done once when the app starts
try:
    model = joblib.load('iris_model.pkl')
    print(" Model loaded successfully.")
except FileNotFoundError:
    print("X Error: Model file 'iris_model.pkl' not found. Please run train_model.py first.")
    model = None
# Define the target names for the Iris dataset
iris_target_names = ['setosa', 'versicolor', 'virginica']

@app.route('/')
def home():
    return "<h1>Iris Classifier API</h1><p>Send a POST request to /predict to get a prediction.</p>"

@app.route('/predict', methods=['POST'])
def predict():
    """Receives input data in JSON format, makes a prediction, and returns it."""
    if model is None:
        return jsonify({'error': "Model is not loaded."}), 500
    try:
        # Get the JSON data from the POST request
        data = request.get_json(force=True)
        # Extract the features from the JSON data
        # Expected format: {"features": [5.1, 3.5, 1.4, 0.2]}
        features = np.array(data['features']).reshape(1, -1)
        # Make a prediction using the loaded model
        prediction_index = model.predict(features)
        # Get the probability scores for each class
        probabilities = model.predict_proba(features)
        # Get the name of the predicted class
        predicted_class_name = iris_target_names[prediction_index[0]]
        # Create the response JSON
        response = {
            'prediction': predicted_class_name,
            'prediction_index': int(prediction_index[0]),
            'confidence_scores': probabilities[0].tolist()
        }
        return jsonify(response)
    except Exception as e:
        return jsonify({'error': str(e)}), 400
# Main execution block
if __name__ == '__main__':
    # Use port 5000 for the development server
    app.run(port=5000, debug=True)
